{
  "name": "pims-workspace",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "backend": "powershell -ExecutionPolicy Bypass -Command \"$env:SPRING_PROFILES_ACTIVE='sqlserver'; & ./backend/scripts/start-backend.ps1\"",
    "backend:h2": "powershell -ExecutionPolicy Bypass -Command \"$env:SPRING_PROFILES_ACTIVE='h2'; & ./backend/scripts/start-backend.ps1\"",
    "backend:sqlserver": "powershell -ExecutionPolicy Bypass -Command \"$env:SPRING_PROFILES_ACTIVE='sqlserver'; & ./backend/scripts/start-backend.ps1\"",
    "dev": "npm run dev:frontend"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react-bootstrap": "^2.10.10",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.16.0"
  }
}
